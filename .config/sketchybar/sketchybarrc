# vim: set ft=sh:
# example setup and explanation of config: https://www.josean.com/posts/sketchybar-setup
# docs: https://felixkratz.github.io/SketchyBar/
PLUGIN_DIR="$CONFIG_DIR/plugins"

source "$CONFIG_DIR/colors.sh" # Loads all defined colors

BRACKET_HEIGHT=32

default=(
  padding_left=5
  padding_right=5
  icon.font="Hack Nerd Font:Bold:17.0"
  label.font="SF Pro:Semibold:15.0"
  #icon.color=0xffffffff
  icon.color=$GREEN
  #label.color=0xffffffff
  label.color=$GREY
  icon.padding_left=5
  icon.padding_right=2
  label.padding_left=2
  label.padding_right=10
  background.color=$ITEM_BG_COLOR
  updates=on
)

bar_config=(
  margin=5
  padding_left=0
  padding_right=0
  color=0x00000000
  corner_radius=20
  position=top
  blur_radius=100
  height=35
  y_offset=5
)

sketchybar --bar "${bar_config[@]}"
sketchybar --default "${default[@]}"
sketchybar --add event aerospace_workspace_change

for sid in $(aerospace list-workspaces --all); do
    sketchybar --add item space.$sid left \
      --subscribe space.$sid aerospace_workspace_change \
      --set space.$sid \
      background.color=0x44ffffff \
      background.corner_radius=5 \
      background.height=20 \
      background.drawing=off \
      label="$sid" \
      click_script="aerospace workspace $sid" \
      script="$CONFIG_DIR/plugins/aerospace.sh $sid"
done

front_app_params=(
  background.color="$BAR_COLOR"
  background.corner_radius=12
  background.height="$BRACKET_HEIGHT"
  label.color="$ACCENT_COLOR"
  label.padding_left=5
  label.padding_right=5
  icon.drawing=off
  script="$PLUGIN_DIR/front_app.sh"
)
sketchybar --add item front_app q \
  --set front_app "${front_app_params[@]}" \
  --subscribe front_app front_app_switched

sketchybar --set space.1 label="1" icon= icon.color="$GREEN"
sketchybar --set space.2 label="2" icon=󰈹 icon.color="$ORANGE"
sketchybar --set space.3 label="3" icon=󰊻 icon.color="$BLUE"
sketchybar --set space.4 label="4" icon=󰴢 icon.color="$BLUE"
sketchybar --set space.5 label="5" icon= icon.color="$PURPLE"

bg_options=(
  background.color="$BAR_COLOR"
  background.corner_radius=12
  background.height="$BRACKET_HEIGHT"
)
sketchybar --add item clock right \
  --set clock update_freq=10 script="$PLUGIN_DIR/clock.sh" "${bg_options[@]}" \
  --add item volume right \
  --set volume script="$PLUGIN_DIR/volume.sh" "${bg_options[@]}" \
  --subscribe volume volume_change \
  --add item battery right \
  --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" "${bg_options[@]}" \
  --subscribe battery system_woke power_source_change \
  --add item now-playing right \
  --set now-playing update_freq=5 script="$PLUGIN_DIR/nowplaying.sh" "${bg_options[@]}"

# Spaces bracket
sketchybar --add bracket spaces '/space\..*/' \
  --set spaces "${bg_options[@]}"

sketchybar --update
